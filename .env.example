# Copy to .env and fill in.

# From https://platform.claude.com/ — leave empty to run in offline demo mode (keyword-matched FAQ answers).
ANTHROPIC_API_KEY=

# Password for the dashboard at /admin.
ADMIN_PASSWORD=change-me

# Signs dashboard login cookies. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 in production (HTTPS) so the login cookie is never sent over plain HTTP.
SECURE_COOKIES=0

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# DATABASE_PATH=data/support.db
# VISITOR_MESSAGES_PER_MINUTE=8
# BOT_MESSAGES_PER_MINUTE=60
